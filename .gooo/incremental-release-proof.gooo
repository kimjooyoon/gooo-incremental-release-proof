contract "gooo/incremental-release-proof/v1" {
  authority "metacode"
  precedence "REFUTED" "UNKNOWN" "CLOSED"
  unknown_fields "stage" "step" "reason" "unknown_class" "next_operation" "blocked_by"
  denominator "incremental-release-proof-v1" count "9"
  inventory root_readme "excluded" file_classes "go,gooo,subdirectory,regular_file" physical_lines "required"
  metrics stages "compile,build,test,conformance,integration" fields "wall_ms,peak_rss_kib" test_counts "total,selected,executed,reused,failed,unknown" improvement "exact-scenario-source-contract-fixture-toolchain-runner-pair-only" missing "null+UNKNOWN"
  authority_rule repository_writes "0" output_scope "CALLER_OWNED_TEMP_OUTPUT_ONLY" automatic_commit "0" automatic_push "0" automatic_merge "0" automatic_release "0" local_verification_authority "GITHUB_ACTIONS_ONLY"
  generation language "go" role "evaluator,generator,runtime" output_scope "CALLER_OWNED_TEMP_OUTPUT_ONLY"
  activity id "load-parent-checkpoint" name "LoadParentCheckpoint" proof "PARENT_CHECKPOINT_BOUND" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "verify-parent-immutability" name "VerifyParentImmutability" proof "PARENT_IMMUTABILITY_PROVEN" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "verify-parent-digest-links" name "VerifyParentDigestLinks" proof "PARENT_ROOT_AND_ASSET_DIGESTS_MATCHED" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "verify-changed-remote-evidence" name "VerifyChangedRemoteEvidence" proof "CHANGED_RELEASE_REMOTE_EVIDENCE_COMPLETE" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "verify-chain-continuity" name "VerifyChainContinuity" proof "PARENT_ROOT_LINK_CONTINUOUS" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "preserve-historical-unknown" name "PreserveHistoricalSurvivalUnknown" proof "UNPROVEN_HISTORICAL_SURVIVAL_SEPARATED" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "refuse-cache-auto-close" name "RefuseCacheAutoClose" proof "CACHE_HIT_REQUIRES_PROOF" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "verify-exact-pair" name "VerifyExactMeasurementPair" proof "EXACT_INTEGER_PAIR_VERIFIED" artifact "generated/release-lock.json" authority "READ_ONLY"
  activity id "emit-six-field-unknown" name "EmitSixFieldUnknown" proof "UNKNOWN_FRONTIER_COMPLETE" artifact "report.json" authority "READ_ONLY"
  activity id "emit-refutation" name "EmitKnownContradiction" proof "REFUTATION_PRESERVED" artifact "report.json" authority "READ_ONLY"
  activity id "deterministic-replay" name "DeterministicReplay" proof "REPLAY_IDENTITY_MATCHED" artifact "replay.json" authority "READ_ONLY"
  activity id "emit-ci-evidence" name "EmitCIEvidence" proof "INTEGER_CI_EVIDENCE_EMITTED" artifact "ci-metrics.json" authority "READ_ONLY"
  rule id "parent-reuse" status "CLOSED" requires "parent-immutability,digest-links,changed-remote-evidence,chain-continuity"
  rule id "cache-reuse" status "CLOSED" requires "independent-parent-and-current-proof"
  rule id "missing-parent" status "UNKNOWN" unknown_class "PARENT_CHECKPOINT_MISSING_OR_UNUSABLE" next_operation "obtain-immutable-parent-checkpoint" blocked_by "parent_checkpoint"
  rule id "historical-survival" status "UNKNOWN" unknown_class "HISTORICAL_REMOTE_SURVIVAL_UNPROVEN" next_operation "requery-every-prior-release" blocked_by "prior_release_current_survival"
  rule id "improvement-pair" status "UNKNOWN" unknown_class "EXACT_MEASUREMENT_PAIR_MISSING" next_operation "rerun-same-scenario-source-contract-fixture-toolchain-runner" blocked_by "before_after_identity"
  scenario id "parent-checkpoint-proven" expected "CLOSED" rule "parent-reuse" replay "false"
  scenario id "changed-release-evidence-verified" expected "CLOSED" rule "parent-reuse" replay "false"
  scenario id "deterministic-replay" expected "CLOSED" rule "cache-reuse" replay "true"
  scenario id "parent-checkpoint-missing" expected "UNKNOWN" rule "missing-parent" replay "false"
  scenario id "parent-checkpoint-stale" expected "UNKNOWN" rule "missing-parent" replay "false"
  scenario id "improvement-pair-missing" expected "UNKNOWN" rule "improvement-pair" replay "false"
  scenario id "parent-digest-contradiction" expected "REFUTED" rule "parent-reuse" replay "false"
  scenario id "changed-asset-digest-mismatch" expected "REFUTED" rule "parent-reuse" replay "false"
  scenario id "chain-discontinuity" expected "REFUTED" rule "parent-reuse" replay "false"
}
