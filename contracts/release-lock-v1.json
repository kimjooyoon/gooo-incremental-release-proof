{
  "schema": "gooo/incremental-release-proof/release-lock/v1",
  "authority": "immutable_public_release_checkpoint",
  "status_precedence": ["REFUTED", "UNKNOWN", "CLOSED"],
  "checkpoint": {
    "required": [
      "immutable_release_id",
      "annotated_tag_object_sha",
      "peeled_commit_sha",
      "ci.run_id",
      "ci.job_id",
      "ci.artifact_id",
      "source_asset.id",
      "source_asset.size",
      "source_asset.digest",
      "evidence_asset.id",
      "evidence_asset.size",
      "evidence_asset.digest",
      "merkle_root_digest",
      "lock_root_digest"
    ],
    "unchanged_release_remote_queries": 0,
    "new_or_changed_release_remote_queries": "complete-evidence-only"
  },
  "unknown": {
    "fields": ["stage", "step", "reason", "unknown_class", "next_operation", "blocked_by"],
    "parent_missing_stale_ambiguous_unbounded": "UNKNOWN",
    "historical_survival_unproven": "separate-UNKNOWN-claim"
  },
  "improvement": {
    "identity": ["scenario", "source", "contract", "fixture", "toolchain", "runner"],
    "before_after": ["wall_ms", "peak_rss_kib"],
    "missing_status": "UNKNOWN"
  },
  "authority_boundary": {
    "repository_writes": 0,
    "generated_output": "caller-owned-temp-only",
    "local_verification": "not-authoritative",
    "github_actions_token": "github.token"
  }
}
